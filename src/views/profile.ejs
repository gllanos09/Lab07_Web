<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title: 'Mi cuenta · Lab07' }) %>
</head>
<body class="app-body">
<%- include('partials/navbar') %>

<main class="container app-main">
  <h5 class="section-title">Mi cuenta</h5>

  <div class="card app-card">
    <form id="profile-form" class="row">
      <div class="input-field col s12 m6">
        <input id="email" type="email" disabled>
        <label for="email" class="active">Correo electrónico</label>
      </div>
      <div class="input-field col s12 m6">
        <input id="age" type="text" disabled>
        <label for="age" class="active">Edad</label>
      </div>

      <div class="input-field col s12 m6">
        <input id="name" type="text">
        <label for="name" class="active">Nombres</label>
      </div>
      <div class="input-field col s12 m6">
        <input id="lastName" type="text">
        <label for="lastName" class="active">Apellidos</label>
      </div>

      <div class="input-field col s12 m6">
        <input id="phoneNumber" type="tel">
        <label for="phoneNumber" class="active">Teléfono</label>
      </div>
      <div class="input-field col s12 m6">
        <input id="birthdate" type="date">
        <label for="birthdate" class="active">Fecha de nacimiento</label>
      </div>

      <div class="input-field col s12 m6">
        <input id="url_profile" type="text">
        <label for="url_profile" class="active">URL de foto de perfil</label>
      </div>
      <div class="input-field col s12 m6">
        <input id="address" type="text">
        <label for="address" class="active">Dirección</label>
      </div>

      <div class="col s12">
        <p>Roles: <span id="roles" class="role-chip"></span></p>
      </div>

      <div id="form-error" class="auth-error col s12"></div>
      <div id="form-success" class="auth-success col s12"></div>

      <div class="col s12">
        <button class="btn waves-effect waves-light" type="submit">
          Guardar cambios <i class="material-icons right">save</i>
        </button>
      </div>
    </form>
  </div>
</main>

<%- include('partials/scripts') %>
<script src="/js/profile.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="es">
<head>
<%- include('partials/head', { title: 'Crear cuenta · Lab07' }) %>
</head>
<body class="auth-body">
  <main class="auth-wrapper">
    <div class="auth-card card signup-card">
      <div class="auth-brand">
        <span class="material-icons">person_add</span>
        <h5>Crea tu cuenta</h5>
        <p>Completa tus datos para registrarte</p>
      </div>

      <form id="signup-form">
        <div class="row">
          <div class="input-field col s12 m6">
            <input id="name" type="text" required>
            <label for="name">Nombres</label>
          </div>
          <div class="input-field col s12 m6">
            <input id="lastName" type="text" required>
            <label for="lastName">Apellidos</label>
          </div>
        </div>

        <div class="row">
          <div class="input-field col s12 m6">
            <input id="phoneNumber" type="tel" required>
            <label for="phoneNumber">Teléfono</label>
          </div>
          <div class="input-field col s12 m6">
            <input id="birthdate" type="date" required>
            <label for="birthdate" class="active">Fecha de nacimiento</label>
          </div>
        </div>

        <div class="input-field">
          <input id="email" type="email" required>
          <label for="email">Correo electrónico</label>
        </div>

        <div class="input-field">
          <input id="password" type="password" required>
          <label for="password">Contraseña</label>
          <span class="helper-text">Mínimo 8 caracteres, 1 mayúscula, 1 dígito y 1 carácter especial (# $ % & * @)</span>
        </div>

        <div id="form-error" class="auth-error"></div>

        <button class="btn waves-effect waves-light auth-btn" type="submit">
          Registrarme <i class="material-icons right">how_to_reg</i>
        </button>
      </form>

      <p class="auth-switch">¿Ya tienes cuenta? <a href="/signin">Inicia sesión</a></p>
    </div>
  </main>

  <%- include('partials/scripts') %>
  <script src="/js/signup.js"></script>
</body>
</html>
